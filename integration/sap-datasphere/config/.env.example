# Secrets for LOCAL runs. Copy to .env (gitignored) and fill in. In Cloud Foundry these come
# from bound services (VCAP_SERVICES / CUPS) instead — the same key names are used.

# ---- SAP Datasphere auth: set the keys matching datasphere.auth.type in config.yaml ----

# auth.type: cookie  (works today; fastest way to test -- no admin/OAuth needed).
# Capture the FULL browser Cookie header (DevTools -> Network -> Copy as cURL). Include the CF routing
# cookie __VCAP_ID__ too, not just JSESSIONID -- the data-access gateway is instance-routed and can
# 401 without it. See README "Getting a session cookie". One line; session-scoped (expires).
DATASPHERE_COOKIE=__VCAP_ID__=_replace_me_; JSESSIONID=s%3A_replace_me_; __VCAP_ID_META__=_replace_me_

# auth.type: basic
# DATASPHERE_USERNAME=
# DATASPHERE_PASSWORD=

# auth.type: bearer
# DATASPHERE_TOKEN=

# auth.type: oauth2_client_credentials  (production, needs an OAuth client)
# DATASPHERE_TOKEN_URL=https://<tenant>.authentication.eu10.hana.ondemand.com/oauth/token
# DATASPHERE_CLIENT_ID=
# DATASPHERE_CLIENT_SECRET=

# ---- OpenLineage transport secret (only if the transport needs an API key, e.g. an http transport) ----
# OPENLINEAGE_API_KEY=
