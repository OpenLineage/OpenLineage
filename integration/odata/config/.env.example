# Secrets for LOCAL runs. Copy to .env (gitignored) and fill in. In Cloud Foundry these come
# from bound services (VCAP_SERVICES / CUPS) instead — the same key names are used.

# ---- Source auth: set the keys matching datasphere.auth.type in config.yaml ----

# auth.type: oauth2_client_credentials  (default; OAuth client with purpose "API Access")
# Datasphere: System -> Administration -> App Integration shows the Token URL.
DATASPHERE_TOKEN_URL=https://<tenant>.authentication.<region>.hana.ondemand.com/oauth/token
DATASPHERE_CLIENT_ID=
DATASPHERE_CLIENT_SECRET=

# auth.type: oauth2_refresh_token  (OAuth client with purpose "Interactive Usage")
# Uses the three keys above plus a refresh token printed once by `python -m app.oauth_login`.
# DATASPHERE_REFRESH_TOKEN=

# auth.type: basic
# DATASPHERE_USERNAME=
# DATASPHERE_PASSWORD=

# auth.type: bearer
# DATASPHERE_TOKEN=

# auth.type: cookie  (DEV/DEMO ONLY -- session-scoped, expires; use OAuth in production)
# The full browser Cookie header on one line, including __VCAP_ID__, not just JSESSIONID.
# DATASPHERE_COOKIE=__VCAP_ID__=_replace_me_; JSESSIONID=s%3A_replace_me_; __VCAP_ID_META__=_replace_me_

# ---- OpenLineage transport secret (only if the transport needs an API key, e.g. an http transport) ----
# OPENLINEAGE_API_KEY=
